@ECHO OFF
SETLOCAL
SET "PATH=@OPENCV_PATH_STR@;@NVVFX_DYNAMIC_LIBRARY_DIRS@;%PATH%"

SET "INPUT_VIDEO=input_vfg.mp4"
REM Due to OpenCV limitations in processing 10-bit video, the sample app supports 10-bit input through images only. To process 10-bit video, replace its OpenCV video decoding path with a decoder that preserves 10-bit frame data and pass those frames to the SDK.
IF /I "%~1"=="--high-quality" GOTO HIGH_QUALITY
IF NOT "%~1"=="" IF /I NOT "%~1"=="--high-quality" (
  ECHO Usage: %~nx0 [--high-quality]
  EXIT /B 2
)

REM Default video examples -- write H.264 directly through OpenCV.
DEL /Q "output_vfg_multiplier.mp4" 2>NUL
VideoFrameGenerationEffectApp.exe --in_file="%INPUT_VIDEO%" --out_file=output_vfg_multiplier.mp4 --mode=medium --multiplier=4
IF ERRORLEVEL 1 (
  ECHO VideoFrameGenerationEffectApp failed in multiplier mode
  DEL /Q "output_vfg_multiplier.mp4" 2>NUL
  EXIT /B 1
)
CALL :VALIDATE_OUTPUT "output_vfg_multiplier.mp4" SUGGEST_FFMPEG
IF ERRORLEVEL 1 EXIT /B 1
ECHO Output video: "output_vfg_multiplier.mp4" was created successfully.

DEL /Q "output_vfg_timesteps.mp4" 2>NUL
VideoFrameGenerationEffectApp.exe --in_file="%INPUT_VIDEO%" --out_file=output_vfg_timesteps.mp4 --mode=medium --timesteps=0.3,0.5,0.8
IF ERRORLEVEL 1 (
  ECHO VideoFrameGenerationEffectApp failed in timestep mode
  DEL /Q "output_vfg_timesteps.mp4" 2>NUL
  EXIT /B 1
)
CALL :VALIDATE_OUTPUT "output_vfg_timesteps.mp4" SUGGEST_FFMPEG
IF ERRORLEVEL 1 EXIT /B 1
ECHO Output video: "output_vfg_timesteps.mp4" was created successfully.

DEL /Q "output_vfg_pinned_memory.mp4" 2>NUL
VideoFrameGenerationEffectApp.exe --in_file="%INPUT_VIDEO%" --out_file=output_vfg_pinned_memory.mp4 --mode=medium --multiplier=4 --use_pinned_memory=true
IF ERRORLEVEL 1 (
  ECHO VideoFrameGenerationEffectApp failed in pinned-memory mode
  DEL /Q "output_vfg_pinned_memory.mp4" 2>NUL
  EXIT /B 1
)
CALL :VALIDATE_OUTPUT "output_vfg_pinned_memory.mp4" SUGGEST_FFMPEG
IF ERRORLEVEL 1 EXIT /B 1
ECHO Output video: "output_vfg_pinned_memory.mp4" was created successfully.
EXIT /B 0

:HIGH_QUALITY
REM High-quality video examples -- write lossless intermediates and encode with FFmpeg.
DEL /Q "output_vfg_multiplier_temp.avi" 2>NUL
VideoFrameGenerationEffectApp.exe --in_file="%INPUT_VIDEO%" --out_file=output_vfg_multiplier_temp.avi --codec=ULRG --mode=medium --multiplier=4
IF ERRORLEVEL 1 (
  ECHO VideoFrameGenerationEffectApp failed in multiplier mode
  DEL /Q "output_vfg_multiplier_temp.avi" 2>NUL
  EXIT /B 1
)
CALL :ENCODE_OUTPUT "output_vfg_multiplier_temp.avi" "output_vfg_multiplier.mp4"
IF ERRORLEVEL 1 EXIT /B 1

DEL /Q "output_vfg_timesteps_temp.avi" 2>NUL
VideoFrameGenerationEffectApp.exe --in_file="%INPUT_VIDEO%" --out_file=output_vfg_timesteps_temp.avi --codec=ULRG --mode=medium --timesteps=0.3,0.5,0.8
IF ERRORLEVEL 1 (
  ECHO VideoFrameGenerationEffectApp failed in timestep mode
  DEL /Q "output_vfg_timesteps_temp.avi" 2>NUL
  EXIT /B 1
)
CALL :ENCODE_OUTPUT "output_vfg_timesteps_temp.avi" "output_vfg_timesteps.mp4"
IF ERRORLEVEL 1 EXIT /B 1

DEL /Q "output_vfg_pinned_memory_temp.avi" 2>NUL
VideoFrameGenerationEffectApp.exe --in_file="%INPUT_VIDEO%" --out_file=output_vfg_pinned_memory_temp.avi --codec=ULRG --mode=medium --multiplier=4 --use_pinned_memory=true
IF ERRORLEVEL 1 (
  ECHO VideoFrameGenerationEffectApp failed in pinned-memory mode
  DEL /Q "output_vfg_pinned_memory_temp.avi" 2>NUL
  EXIT /B 1
)
CALL :ENCODE_OUTPUT "output_vfg_pinned_memory_temp.avi" "output_vfg_pinned_memory.mp4"
IF ERRORLEVEL 1 EXIT /B 1
EXIT /B 0

:ENCODE_OUTPUT
CALL :VALIDATE_OUTPUT "%~1" CHECK_DEPENDENCIES
IF ERRORLEVEL 1 EXIT /B 1
DEL /Q "%~2" 2>NUL
REM Encode the lossless intermediate as H.264.
ffmpeg.exe -hide_banner -loglevel error -y -i "%~1" -map 0:v:0 -c:v libx264 -crf 1 -pix_fmt yuv420p -an -movflags +faststart "%~2"
IF ERRORLEVEL 1 (
  ECHO ffmpeg failed while creating "%~2"
  DEL /Q "%~2" 2>NUL
  EXIT /B 1
)
CALL :VALIDATE_OUTPUT "%~2"
IF ERRORLEVEL 1 EXIT /B 1

DEL /Q "%~1"
ECHO Output video: "%~2" was created successfully.
EXIT /B 0

:VALIDATE_OUTPUT
IF NOT EXIST "%~1" (
  ECHO Expected output "%~1" was not created
  EXIT /B 1
)
FOR %%A IN ("%~1") DO IF %%~zA EQU 0 (
  ECHO Expected output "%~1" is empty
  IF /I "%~2"=="SUGGEST_FFMPEG" (
    ECHO Consider rerunning this script with --high-quality to encode the output with FFmpeg.
    ECHO Review README.md and install the required dependencies before using --high-quality.
  )
  IF /I "%~2"=="CHECK_DEPENDENCIES" ECHO Review README.md and verify that the required dependencies are installed.
  DEL /Q "%~1" 2>NUL
  EXIT /B 1
)
EXIT /B 0
