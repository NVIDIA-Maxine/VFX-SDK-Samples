#!/bin/sh

. ./setup_env.sh

# VideoFrameGeneration image input example -- 10 bit + multiplier mode
rm -f out_1.png out_2.png out_3.png
if ! ./VideoFrameGenerationEffectApp \
    --input_frame_prev=input_vfg_10bit_1.png \
    --input_frame_current=input_vfg_10bit_2.png \
    --output_frame_path=out.png \
    --mode=medium \
    --use_pinned_memory=true \
    --multiplier=4; then
    echo "VideoFrameGenerationEffectApp failed in 10-bit image mode"
    rm -f out_1.png out_2.png out_3.png
    exit 1
fi

echo "Output image: \"out_1.png\" was created successfully."
echo "Output image: \"out_2.png\" was created successfully."
echo "Output image: \"out_3.png\" was created successfully."
