SETLOCAL
SET "PATH=@OPENCV_PATH_STR@;@NVVFX_DYNAMIC_LIBRARY_DIRS@;%PATH%"
REM VideoSuperRes webcam example - upscales live webcam feed
VideoSuperResEffectApp.exe --cam_res=1280x720 --resolution=1080 --mode=1 --webcam --show
IF ERRORLEVEL 1 (
  ECHO VideoSuperResEffectApp webcam processing failed.
  EXIT /B 1
)
ECHO VideoSuperResEffectApp webcam processing completed successfully.
EXIT /B 0
