@ECHO OFF
REM Package a headerless RGB10A2 .r10 into a playable HDR10-tagged HEVC .mp4 via
REM ffmpeg. ffmpeg is a SOFT dependency: if it is missing or too old this script
REM prints a single non-fatal warning and exits 5 (soft-skip), leaving the .r10
REM in place.
REM
REM Usage:
REM   package_hdr10.bat <r10_path> <width> <height> [framerate]
REM
REM Exit codes:
REM   0  packaged (.mp4 written, non-empty, HDR10-tagged)
REM   2  bad arguments
REM   3  missing or unreadable raw input .r10
REM   4  ffmpeg was invoked but the encode failed
REM   5  soft-skip: ffmpeg missing or too old (no .mp4 written)
REM
REM framerate defaults to 30; single-frame image outputs should pass 1 so the
REM still is held for ~1 s in HDR10 players.
SETLOCAL DisableDelayedExpansion
SET "R10=%~1"
SET "W=%~2"
SET "H=%~3"
SET "FPS=%~4"
IF NOT DEFINED FPS SET "FPS=30"

REM Name each missing mandatory arg explicitly
SET "MISSING="
IF NOT DEFINED R10 SET "MISSING=%MISSING% r10_path"
IF NOT DEFINED W   SET "MISSING=%MISSING% width"
IF NOT DEFINED H   SET "MISSING=%MISSING% height"
IF DEFINED MISSING GOTO :usage
GOTO :precheck

:usage
echo [package_hdr10] ERROR: missing required argument(s):%MISSING% 1>&2
echo [package_hdr10] usage: package_hdr10.bat ^<r10_path^> ^<width^> ^<height^> [framerate] 1>&2
echo [package_hdr10]   r10_path : path to the raw RGB10A2 .r10 produced by TrueHDREffectApp 1>&2
echo [package_hdr10]   width    : output frame width in pixels ^(must match the value TrueHDREffectApp wrote^) 1>&2
echo [package_hdr10]   height   : output frame height in pixels ^(must match the value TrueHDREffectApp wrote^) 1>&2
echo [package_hdr10]   framerate: optional, default 30. Use 1 for a single-frame image so HDR10 players hold it for ~1 s. 1>&2
EXIT /B 2

:precheck
IF NOT EXIST "%R10%" (
    echo [package_hdr10] ERROR: input .r10 not found or unreadable: %R10% 1>&2
    echo [package_hdr10]        ^(this is package_hdr10's mandatory input; TrueHDREffectApp was expected to write it^) 1>&2
    EXIT /B 3
)
WHERE ffmpeg >NUL 2>&1
IF ERRORLEVEL 1 (
    echo [package_hdr10] ffmpeg not on PATH; skipping HDR10-HEVC packaging ^(soft-skip, exit 5^).
    echo [package_hdr10] install ffmpeg ^>=5.0 ^(see README install instructions^) and re-run
    echo [package_hdr10] for a playable HDR10-tagged .mp4. Raw .r10 still available.
    EXIT /B 5
)
ffmpeg -hide_banner -pix_fmts 2>NUL | findstr /R /C:" x2bgr10le " >NUL
IF ERRORLEVEL 1 (
    echo [package_hdr10] this ffmpeg lacks pix_fmt x2bgr10le ^(need ffmpeg ^>=5.0^);
    echo [package_hdr10] skipping HDR10-HEVC packaging ^(soft-skip, exit 5^). Raw .r10 still available at %R10%.
    echo [package_hdr10] upgrade ffmpeg or run the recipe by hand on a host with ffmpeg ^>=5.0 ^(see README^).
    EXIT /B 5
)

REM File-size sanity check
SET "SIZE_MSG="
SET "PKG_R10=%R10%"
SET "PKG_W=%W%"
SET "PKG_H=%H%"
FOR /F "usebackq delims=" %%B IN (`powershell -NoProfile -Command "$w = $env:PKG_W -as [int64]; $h = $env:PKG_H -as [int64]; if ($w -le 0 -or $h -le 0) { return }; $bpf = $w * $h * 4; $b = (Get-Item -LiteralPath $env:PKG_R10).Length; $r = [int64]$b %% $bpf; $fc = ([int64]$b - $r) / $bpf; if ($fc -eq 0) { 'TOOSMALL ' + $b + ' ' + $bpf } elseif ($r -ne 0) { 'MISMATCH ' + $b + ' ' + $bpf + ' ' + $fc + ' ' + $r }"`) DO SET "SIZE_MSG=%%B"
IF DEFINED SIZE_MSG (
    FOR /F "tokens=1,2,3,4,5" %%A IN ("%SIZE_MSG%") DO (
        IF "%%A"=="TOOSMALL" (
            echo [package_hdr10] WARNING: %R10% is only %%B bytes but %W%x%H% RGB10A2 needs ^>= %%C bytes/frame. 1>&2
            echo [package_hdr10]          Check that width/height match TrueHDREffectApp's actual output. 1>&2
        )
        IF "%%A"=="MISMATCH" (
            echo [package_hdr10] WARNING: %R10% is %%B bytes, not a whole multiple of %W%x%H%x4=%%C bytes/frame ^(%%D full frames + %%E trailing bytes^). 1>&2
            echo [package_hdr10]          If the resulting .mp4 looks garbled, verify width/height match what TrueHDREffectApp wrote. 1>&2
        )
    )
)

SET "MP4=%R10:.r10=.mp4%"
IF "%MP4%"=="%R10%" SET "MP4=%R10%.mp4"

REM libx265 with yuv420p10le requires even width AND height (4:2:0 chroma). Pad
REM odd dimensions with at most 1 black pixel on the right/bottom so the encoder
REM accepts the frame; existing picture stays anchored at (0,0).
SET /A "PADDED_W=(%W%+1)/2*2"
SET /A "PADDED_H=(%H%+1)/2*2"
IF NOT "%PADDED_W%x%PADDED_H%"=="%W%x%H%" echo [package_hdr10] odd dimensions %W%x%H%: padding to %PADDED_W%x%PADDED_H% for HEVC 4:2:0 alignment

echo [package_hdr10] packaging %R10% (%W%x%H% @ %FPS%fps) -^> %MP4% via ffmpeg (HDR10-tagged HEVC)
ffmpeg -y -hide_banner -loglevel warning ^
    -f rawvideo -pixel_format x2bgr10le -video_size %W%x%H% -framerate %FPS% ^
    -i "%R10%" ^
    -vf "pad=ceil(iw/2)*2:ceil(ih/2)*2:0:0:black" ^
    -c:v libx265 -pix_fmt yuv420p10le ^
    -x265-params "crf=20:colorprim=bt2020:transfer=smpte2084:colormatrix=bt2020nc:hdr-opt=1" ^
    "%MP4%"
SET "FFMPEG_RC=%ERRORLEVEL%"
IF NOT "%FFMPEG_RC%"=="0" (
    REM ffmpeg may have opened %MP4% for writing before failing, leaving a
    REM partial/unplayable file. Remove it so the exit-code contract
    REM ("exit 4 => no .mp4") is enforced and downstream tools don't pick
    REM up a corrupt output.
    DEL /Q "%MP4%" 2>NUL
    echo [package_hdr10] ERROR: ffmpeg failed ^(rc=%FFMPEG_RC%^); raw .r10 still available at %R10% 1>&2
    ENDLOCAL & EXIT /B 4
)
ENDLOCAL
